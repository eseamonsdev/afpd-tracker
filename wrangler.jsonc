{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afpd-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "AFPD_DB",
      "database_name": "afpd-data",
      "database_id": "9f14e9d9-4326-472e-9c31-ada5b8825e91"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RADIO_AUDIO",
      "bucket_name": "afpd-public-media"
    }
  ]
}
