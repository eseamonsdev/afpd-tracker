{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afpd-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "RADIO_AUDIO",
      "bucket_name": "afpd-public-media"
    }
  ]
}
