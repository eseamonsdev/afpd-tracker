---
permalink: /admin/index.html
sitemap: false
---
{% extends "admin-layout.njk" %}
{% set pageTitle = "Dashboard | AFPD Admin" %}
{% set adminSection = "dashboard" %}
{% block content %}
  <div class="admin-page-heading">
    <h1>Dashboard</h1>
    <p>Manage the AFPD Accountability Project.</p>
  </div>
  <nav class="admin-tool-grid" aria-label="Admin tools">
    {% for tool in adminTools %}
    <a class="admin-tool-card" href="{{ tool.url }}">
      <h2>{{ tool.title }}</h2>
      <p>{{ tool.description }}</p>
      <span class="admin-tool-action">{{ tool.action }} <span aria-hidden="true">→</span></span>
    </a>
    {% endfor %}
  </nav>
{% endblock %}
