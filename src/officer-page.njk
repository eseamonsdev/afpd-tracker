---
pagination:
  addAllPagesToCollections: true
  data: entities.byType.officer-page
  size: 1
  alias: officerPage
permalink: "{{ officerPage.url }}"
---
{% extends "site-page-layout.njk" %}
{% from "document-tree.njk" import renderNodes -%}
{% from "profile-names.njk" import renderAlternateNames -%}
{% set alternateNames = officerPage | profileAlternateNames -%}
{% set observedAgencyIds = officerPage.observed_agency_ids or [] -%}
{% set siteUrl = "https://afpd-accountability.com" -%}
{% set pageTitle = officerPage.seo_title or (officerPage.name ~ " — Officer Records | AFPD Accountability Project") -%}
{% set defaultDescription = "Explore records related to " ~ officerPage.name ~ "’s service with the American Fork Police Department." -%}
{% set pageDescription = officerPage.seo_description or defaultDescription -%}
{% set canonicalUrl = siteUrl ~ officerPage.url -%}
{% set sections = officerPage.sections | publishedSections -%}

{% block pageAssets %}  <link rel="stylesheet" href="/css/document-tree.css">
  <link rel="stylesheet" href="/css/officer-page.css">
  <link rel="stylesheet" href="/css/csv-table.css">

  {% if sections | length %}
    <script src="/js/officer-tabs.js" defer></script>
  {% endif %}
{% endblock %}

{% block content %}
    <a class="officer-back-link" href="/officers/">
      ← All officers
    </a>

    <div class="page-heading">
      <p class="officer-category-label">OFFICER RECORDS</p>
      <h1>{{ (officerPage.display_name or officerPage.name) | escape }}</h1>
    </div>

    {% if sections | length %}
      <div class="officer-sections" data-officer-sections>
        <div
          class="officer-section-tabs"
          data-section-tabs
          hidden
        >
          {% for section in sections %}
            <button
              class="officer-section-tab"
              id="officer-tab-{{ section.id | escape }}"
              type="button"
              data-section-tab="{{ section.id | escape }}"
              aria-controls="officer-section-{{ section.id | escape }}"
            >
              {{ section.title | escape }}
            </button>
          {% endfor %}
        </div>

        {% for section in sections %}
          <section
            class="officer-section-panel"
            id="officer-section-{{ section.id | escape }}"
            aria-labelledby="officer-section-heading-{{ section.id | escape }}"
            data-section-panel
          >
            <h2 id="officer-section-heading-{{ section.id | escape }}">
              {{ section.title | escape }}
            </h2>

            {% if section.id == "observed-agency-ids" %}
              <p>Agency IDs usually stay the same, but can sometimes be reassigned. They can be a useful indicator or hint of identity, but are not absolute proof. The associations below apply to the cited records and dates.</p>
              <div class="csv-table-scroll" tabindex="0" role="region" aria-label="Observed Agency IDs and supporting evidence">
                <table class="csv-table">
                  <thead><tr><th scope="col">Observed Agency ID</th><th scope="col">Date observed</th><th scope="col">Source</th><th scope="col">Supporting evidence</th></tr></thead>
                  <tbody>{% for observation in observedAgencyIds %}
                    <tr><th scope="row"><code>{{ observation.id | escape }}</code></th><td>{% if observation.date %}<time datetime="{{ observation.date | escape }}">{{ observation.date | escape }}</time>{% else %}Not recorded{% endif %}</td><td>{% if observation.url %}<a href="{{ observation.url | escape }}">{{ observation.source | escape }}</a>{% else %}{{ observation.source | escape }}{% endif %}</td><td>{{ observation.evidence | escape }}</td></tr>
                  {% endfor %}</tbody>
                </table>
              </div>
            {% endif %}{% if section.descriptions and section.descriptions | length %}
              <div class="officer-section-descriptions">
                {% for description in section.descriptions %}
                  <p>{% if description.parts %}{% for part in description.parts %}{% if part.url %}<a href="{{ part.url | escape }}">{{ part.text | escape }}</a>{% else %}{{ part | escape }}{% endif %}{% endfor %}{% else %}{{ description | escape }}{% endif %}</p>
                {% endfor %}
              </div>
            {% endif %}

            {% if section.contents and section.contents | length %}
              <ul
                class="tree"
                aria-label="{{ section.title | escape }}"
              >
                {{ renderNodes(section.contents) }}
              </ul>
            {% endif %}{% if section.title == "Overview" and (alternateNames | length) > 0 %}
              {{ renderAlternateNames(alternateNames) }}{% endif %}
          </section>
        {% endfor %}
      </div>
    {% endif %}
{% endblock %}
