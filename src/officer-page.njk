---
pagination:
  data: entities.byType.officer-page
  size: 1
  alias: officerPage
permalink: "{{ officerPage.url }}"
---
{% set siteUrl = "https://afpd-tracker.ericseamonsdeveloper.workers.dev" %}
{% set pageTitle = officerPage.name ~ " — Officer Records | AFPD Accountability Project" %}
{% set defaultDescription = "Explore records related to " ~ officerPage.name ~ "’s service with the American Fork Police Department." %}
{% set pageDescription = officerPage.seo_description or defaultDescription %}
{% set canonicalUrl = siteUrl ~ officerPage.url %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ pageTitle | escape }}</title>
  <meta name="description" content="{{ pageDescription | escape }}">
  <link rel="canonical" href="{{ canonicalUrl | escape }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AFPD Accountability Project">
  <meta property="og:title" content="{{ pageTitle | escape }}">
  <meta property="og:description" content="{{ pageDescription | escape }}">
  <meta property="og:url" content="{{ canonicalUrl | escape }}">

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ pageTitle | escape }}">
  <meta name="twitter:description" content="{{ pageDescription | escape }}">

  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/officer-page.css">
</head>
<body>
  {% include "header.njk" %}

  <main>
    <a class="officer-back-link" href="/officers/">
      ← All officers
    </a>

    <div class="page-heading">
      <p class="officer-category-label">OFFICER RECORDS</p>
      <h1>{{ officerPage.name | escape }}</h1>
    </div>
  </main>
</body>
</html>
