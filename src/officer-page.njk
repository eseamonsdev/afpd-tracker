---
pagination:
  addAllPagesToCollections: true
  data: entities.byType.officer-page
  size: 1
  alias: officerPage
permalink: "{{ officerPage.url }}"
---
{% extends "site-page-layout.njk" %}
{% from "document-tree.njk" import renderNodes -%}
{% from "profile-names.njk" import renderAlternateNames -%}
{% set alternateNames = officerPage | profileAlternateNames -%}
{% set observedOfficerIds = officerPage.observed_officer_ids or [] -%}
{% set siteUrl = "https://afpd-accountability.com" -%}
{% set pageTitle = officerPage.seo_title or (officerPage.name ~ " — Officer Records | AFPD Accountability Project") -%}
{% set defaultDescription = "Explore records related to " ~ officerPage.name ~ "’s service with the American Fork Police Department." -%}
{% set pageDescription = officerPage.seo_description or defaultDescription -%}
{% set canonicalUrl = siteUrl ~ officerPage.url -%}
{% set sections = officerPage.sections | publishedSections -%}

{% block pageAssets %}  <link rel="stylesheet" href="/css/document-tree.css">
  <link rel="stylesheet" href="/css/officer-page.css">
  <link rel="stylesheet" href="/css/csv-table.css">

  {% if sections | length %}
    <script src="/js/officer-tabs.js" defer></script>
  {% endif %}
{% endblock %}

{% block content %}
    <a class="officer-back-link" href="/officers/">
      ← All officers
    </a>

    <div class="page-heading">
      <p class="officer-category-label">OFFICER RECORDS</p>
      <h1>{{ (officerPage.display_name or officerPage.name) | escape }}</h1>
    </div>

    {% if sections | length %}
      <div class="officer-sections" data-officer-sections>
        <div
          class="officer-section-tabs"
          data-section-tabs
          hidden
        >
          {% for section in sections %}
            <button
              class="officer-section-tab"
              id="officer-tab-{{ section.id | escape }}"
              type="button"
              data-section-tab="{{ section.id | escape }}"
              aria-controls="officer-section-{{ section.id | escape }}"
            >
              {{ section.title | escape }}
            </button>
          {% endfor %}
        </div>

        {% for section in sections %}
          <section
            class="officer-section-panel"
            id="officer-section-{{ section.id | escape }}"
            aria-labelledby="officer-section-heading-{{ section.id | escape }}"
            data-section-panel
          >
            <h2 id="officer-section-heading-{{ section.id | escape }}">
              {{ section.title | escape }}
            </h2>

            {% if section.id == "observed-agency-ids" %}
              <p>Officers use different identifiers in different situations. The entries below distinguish call signs, UCJIS User IDs, and radio IDs. Each association applies to the cited records and dates.</p>
              {%- for identifierType in ["call-sign", "ucjis-user-id", "radio-id"] -%}
                {%- if identifierType == "call-sign" -%}
                  {%- set identifierTitle = "Call Sign" -%}
                  <h3>Call Sign</h3>
                  <p>A call sign, such as <code>5J45</code>, identifies an officer or unit in radio communications and may also appear in police and court records. Call signs can change or be reassigned.</p>
                {%- elif identifierType == "ucjis-user-id" -%}
                  {%- set identifierTitle = "UCJIS User ID" -%}
                  <h3>UCJIS (Utah Criminal Justice Information System) User ID</h3>
                  <p>UCJIS is Utah’s secure criminal justice information system, managed by the Utah Bureau of Criminal Identification (BCI). It provides authorized access to state and federal databases, including the FBI’s National Crime Information Center (NCIC). An agency’s Terminal Agency Coordinator (TAC) assigns each user an individual account and User ID. See <a href="https://ucjis-tac.utah.gov/wp-content/uploads/sites/38/2021/02/UCJIS-Basics-Revised-02182021.pdf">BCI’s UCJIS Basics</a> and <a href="https://ucjis-tac.utah.gov/wp-content/uploads/sites/38/2023/10/TAC-Responsibilities-1.pdf">TAC Responsibilities</a>.</p>
                  <p>An identifier such as <code>AFSPENCERT</code> in the affidavit’s officer-name field is a UCJIS User ID, not a Spillman ID.</p>
                  <h4>Where You See It</h4>
                  <p>UCJIS User IDs appear in affidavits of probable cause in this format:</p>
                  <p><code>Officer Name: [UCJIS ID] - [Full Name]</code></p>
                {%- else -%}
                  {%- set identifierTitle = "Radio ID" -%}
                  <h3>Radio ID</h3>
                  <p>A radio ID is the numeric identifier transmitted by a radio device and shown in recording metadata. An officer may use more than one radio, and a device may be shared or reassigned. A radio ID is distinct from the officer’s spoken call sign.</p>
                {%- endif -%}
                {%- set observationsByType = observedOfficerIds | groupby("type") -%}
                {%- set observations = observationsByType[identifierType] or [] -%}
                {%- if observations | length -%}
                  <div class="csv-table-scroll" tabindex="0" role="region" aria-label="{{ identifierTitle | escape }} observations and supporting evidence">
                    <table class="csv-table">
                      <thead><tr><th scope="col">{{ identifierTitle | escape }}</th><th scope="col">Date observed</th><th scope="col">Source</th><th scope="col">Supporting evidence</th></tr></thead>
                      <tbody>{%- for observation in observations -%}
                        <tr><th scope="row"><code>{{ observation.id | escape }}</code></th><td>{%- if observation.date -%}<time datetime="{{ observation.date | escape }}">{{ observation.date | escape }}</time>{%- else -%}Not recorded{%- endif -%}</td><td>{%- if observation.url -%}<a href="{{ observation.url | escape }}">{{ observation.source | escape }}</a>{%- else -%}{{ observation.source | escape }}{%- endif -%}</td><td>{{ observation.evidence | escape }}</td></tr>
                      {%- endfor -%}</tbody>
                    </table>
                  </div>
                {%- else -%}
                  <p>No {{ identifierTitle | escape }} documented in the cited records for this officer.</p>
                {%- endif -%}
              {%- endfor -%}
            {% endif %}{% if section.descriptions and section.descriptions | length %}
              <div class="officer-section-descriptions">
                {% for description in section.descriptions %}
                  <p>{% if description.parts %}{% for part in description.parts %}{% if part.url %}<a href="{{ part.url | escape }}">{{ part.text | escape }}</a>{% else %}{{ part | escape }}{% endif %}{% endfor %}{% else %}{{ description | escape }}{% endif %}</p>
                {% endfor %}
              </div>
            {% endif %}

            {% if section.contents and section.contents | length %}
              <ul
                class="tree"
                aria-label="{{ section.title | escape }}"
              >
                {{ renderNodes(section.contents) }}
              </ul>
            {% endif %}{% if section.title == "Overview" and (alternateNames | length) > 0 %}
              {{ renderAlternateNames(alternateNames) }}{% endif %}
          </section>
        {% endfor %}
      </div>
    {% endif %}
{% endblock %}
