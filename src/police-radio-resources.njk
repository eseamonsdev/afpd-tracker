---
permalink: /police-radio-resources/
---
{% extends "site-page-layout.njk" %}
{% set resources = entities.all["entity-page-police-radio-resources"] -%}
{% set pageTitle = resources.title ~ " | AFPD Accountability Project" -%}
{% set pageDescription = resources.description -%}
{% set canonicalUrl = "https://afpd-accountability.com/police-radio-resources/" -%}

{% block pageAssets %}
  <link rel="stylesheet" href="/css/police-radio-resources.css">
  <script src="/js/police-radio-resources.js" defer></script>
{% endblock %}

{%- block content %}
  <a class="radio-resources-back" href="/police-radio/">&larr; Police Radio</a>
  <div class="page-heading">
    <h1>{{ resources.title | escape }}</h1>
    <p>{{ resources.description | escape }}</p>
  </div>

  <nav class="radio-guide-nav" aria-label="Listening guide">
    <a href="#agency-call-signs">Call signs</a>
    <a href="#radio-language">Radio language</a>
    <a href="#radio-agency-ids">Radio IDs and 5J identifiers</a>
    <a href="#officer-radio-ids">Names and radio IDs</a>
    <a href="#sources">Sources and downloads</a>
  </nav>

  <section class="radio-resources-section" aria-labelledby="agency-call-signs">
    <h2 id="agency-call-signs">{{ resources.callSigns.title | escape }}</h2>
    <p class="radio-resources-description">{{ resources.callSigns.description | escape }}</p>
    <dl class="radio-call-signs">
      {%- for entry in resources.callSigns.entries %}
        <div><dt>{{ entry.sign | escape }}</dt><dd>{{ entry.agency | escape }}</dd></div>
      {%- endfor %}
    </dl>
    <p class="radio-guide-source-links">{%- for id in resources.callSigns.sourceIds %}{%- for source in resources.sources %}{%- if source.id == id %}<a href="#source-{{ source.id | escape }}">{{ source.title | escape }}</a>{%- endif %}{%- endfor %}{%- endfor %}</p>
  </section>

  <section class="radio-resources-section" aria-labelledby="radio-language">
    <h2 id="radio-language">{{ resources.language.title | escape }}</h2>
    <p class="radio-resources-description">{{ resources.language.description | escape }}</p>
    <dl class="radio-guide-language">
      {%- for entry in resources.language.entries %}
        <div><dt>{{ entry.term | escape }}</dt><dd>{{ entry.meaning | escape }} <span>{{ entry.example | escape }}</span></dd></div>
      {%- endfor %}
    </dl>
    <p class="radio-guide-source-links">{%- for id in resources.language.sourceIds %}{%- for source in resources.sources %}{%- if source.id == id %}<a href="#source-{{ source.id | escape }}">{{ source.title | escape }}</a>{%- endif %}{%- endfor %}{%- endfor %}</p>
  </section>

  <section class="radio-resources-section" aria-labelledby="radio-agency-ids">
    <h2 id="radio-agency-ids">{{ radioAgencyIds.title | escape }}</h2>
    <p class="radio-resources-description">{{ radioAgencyIds.description | escape }}</p>
    <div class="radio-id-tabs" role="tablist" aria-label="Radio ID confirmations" hidden>
      <button id="radio-mappings-tab" type="button" role="tab" aria-selected="true" aria-controls="radio-mappings-panel">ID table</button>
      <button id="radio-evidence-tab" type="button" role="tab" aria-selected="false" aria-controls="radio-evidence-panel" tabindex="-1">Evidence</button>
    </div>
    <div id="radio-mappings-panel" aria-labelledby="radio-mappings-tab">
      <div class="radio-guide-table-scroll" tabindex="0" role="region" aria-label="Radio IDs and 5J identifiers">
        <table class="radio-guide-table radio-id-table">
          <caption>Radio ID to agency ID pairings; missing details are marked Not supplied</caption>
          <thead><tr><th scope="col">Radio ID</th><th scope="col">Agency ID (5J)</th><th scope="col">Dates heard on Law 2</th></tr></thead>
          <tbody>{%- for entry in radioAgencyIds.entries %}
            <tr><th scope="row"><code>{{ entry.radioId | escape }}</code></th><td><code>{{ entry.agencyId | escape }}</code></td><td>{% if not entry.dates.length %}Not supplied{% endif %}{%- for date in entry.dates %}<time datetime="{{ date }}">{{ date }}</time>{% if not loop.last %}, {% endif %}{%- endfor %}</td></tr>
          {%- endfor %}</tbody>
        </table>
      </div>
    </div>
    <div id="radio-evidence-panel" aria-labelledby="radio-evidence-tab">
      <div class="radio-guide-table-scroll" tabindex="0" role="region" aria-label="Law 2 confirmation evidence">
        <table class="radio-guide-table radio-id-table">
          <caption>Evidence: owner listening confirmations, one row per date heard. Exact clip timestamps were not supplied.</caption>
          <thead><tr><th scope="col">Radio ID</th><th scope="col">Agency ID (5J)</th><th scope="col">Date heard</th><th scope="col">Channel</th><th scope="col">Evidence</th></tr></thead>
          <tbody>{%- for entry in radioAgencyIds.evidence %}
            <tr><th scope="row"><code>{{ entry.radioId | escape }}</code></th><td><code>{{ entry.agencyId | escape }}</code></td><td>{% if entry.date %}<a href="{{ entry.url | escape }}">{{ entry.date | escape }}</a>{% else %}Not supplied{% endif %}</td><td>{{ entry.talkgroup | escape }}</td><td>{{ entry.basis | escape }}</td></tr>
          {%- endfor %}</tbody>
        </table>
      </div>
    </div>
    <p class="radio-guide-source-links"><a href="/records/openmhz/afpd-radio-agency-ids.xlsx" download>Download IDs and Evidence (.xlsx)</a><a href="/records/openmhz/afpd-radio-agency-ids.csv" download>Download ID table (.csv)</a></p>
  </section>

  <section class="radio-resources-section" aria-labelledby="officer-radio-ids">
    <h2 id="officer-radio-ids">{{ resources.officers.title | escape }}</h2>
    <p class="radio-resources-description">{{ resources.officers.description | escape }}</p>
    <p>This table contains officer–radio associations compiled and reviewed with AI assistance. Personal verification by the site's author is pending. Unless explicitly marked personally verified, associations remain provisional and may include errors, conflicting evidence, or alternative identities.</p>
    <p><a href="https://media.afpd-accountability.com/officer-association-review.html">Listen, edit transcripts, confirm associations, and export your review</a>. New AI search leads are available there for verification and do not count toward association thresholds.</p>
    <p>{{ resources.idExplanation | escape }}</p>
    <p class="radio-resources-attribution">{{ resources.attributionNote | escape }}</p>
    {% set officerCsv = "openmhz/afpd-radio-officer-ids.csv" | readCsv -%}
    <div class="radio-guide-table-scroll" tabindex="0" role="region" aria-label="Officer names and associated radio IDs">
      <table class="radio-guide-table">
        <caption>Evidence days count distinct dates, including unreviewed and conflicting observations. Repeated clips do not increase the day count.</caption>
        <thead><tr><th scope="col">Full name / unresolved name</th><th scope="col">Names heard</th><th scope="col">Radio ID</th><th scope="col">Evidence days</th><th scope="col">Association</th><th scope="col">Evidence dates</th><th scope="col">Evidence</th></tr></thead>
        <tbody>{%- for row in officerCsv.rows %}
          <tr><th scope="row">{% if row[7] %}<a href="{{ row[7] | escape }}">{{ row[1] | escape }}</a>{% else %}{{ row[1] | escape }}{% endif %}</th><td>{{ row[0] | escape }}</td><td><code id="radio-id-{{ row[2] | escape }}-{{ row[8] | escape }}">{{ row[2] | escape }}</code></td><td>{{ row[3] | escape }}</td><td>{{ row[4] | escape }}</td><td>{{ row[5] | escape }}</td><td><details><summary>View dated evidence and clips</summary><div style="white-space: pre-line">{{ row[6] | escape }}</div></details></td></tr>
        {%- endfor %}</tbody>
      </table>
    </div>
    <p>{{ resources.officers.unresolved | escape }}</p>
    {% set evidenceCsv = "openmhz/officer-association-evidence.csv" | readCsv -%}
    <details><summary>Previously excluded observations without an assigned radio/name pairing</summary>
      <table class="radio-guide-table"><thead><tr><th scope="col">Date</th><th scope="col">Clips</th><th scope="col">Evidence and original uncertainty</th></tr></thead><tbody>
      {%- for row in evidenceCsv.rows %}{% if row[6] == "unassigned" %}<tr><td>{{ row[2] | escape }}</td><td>{{ row[4] | escape }}</td><td>{{ row[5] | escape }}</td></tr>{% endif %}{%- endfor %}
      </tbody></table>
    </details>
    <p class="radio-guide-source-links"><a href="/records/openmhz/afpd-radio-officer-ids.csv" download>Download names and radio IDs (.csv)</a><a href="/records/openmhz/officer-association-evidence.csv" download>Download dated evidence and clips (.csv)</a>{%- for id in resources.officers.sourceIds %}{%- for source in resources.sources %}{%- if source.id == id %}<a href="{{ source.url | escape }}" download>Download the full radio-ID spreadsheet</a>{%- endif %}{%- endfor %}{%- endfor %}</p>
  </section>

  <section class="radio-resources-section" aria-labelledby="sources">
    <h2 id="sources">Sources and downloads</h2>
    <p class="radio-resources-description">References used in the guide above. Utah County is listed first for local lookups; the statewide reference covers other agencies.</p>
    <ul class="radio-resources-list">
      {%- for source in resources.sources %}
          <li id="source-{{ source.id | escape }}">
            <h3><a href="{{ source.url | escape }}"{%- if source.download %} download{%- else %} target="_blank" rel="noopener noreferrer"{%- endif %}>{{ source.title | escape }}</a></h3>
            <p class="radio-resource-meta">{{ source.publisher | escape }} · {{ source.format | escape }}</p>
            <p>{{ source.description | escape }}</p>
            {%- if source.coverage %}<p class="radio-resource-coverage"><strong>Coverage:</strong> {{ source.coverage | escape }}</p>{%- endif %}
            {%- if source.note %}<p class="radio-resource-note">{{ source.note | escape }}</p>{%- endif %}
            {%- if source.download %}<a class="radio-resource-download" href="{{ source.url | escape }}" download>Download spreadsheet <span aria-hidden="true">&darr;</span></a>{%- endif %}
          </li>
      {%- endfor %}
    </ul>
  </section>
{%- endblock %}

