{% extends "admin-layout.njk" %}
{% set pageTitle = "Association Evidence | AFPD Admin" %}
{% set adminSection = "association-evidence" %}
{% block pageAssets %}
<link rel="stylesheet" href="/css/admin-association-evidence.css">
<script src="/js/admin-association-evidence.js" defer></script>
{% endblock %}
{% block content %}
<div class="admin-page-heading">
  <h1>Association evidence</h1>
  <p>Open a group to listen, confirm the speaker, and record corrections. Review changes stay in this evidence workspace.</p>
  <p id="evidence-progress" class="evidence-progress" role="status">Loading review progress…</p>
</div>
<form id="evidence-filters" class="evidence-filters">
  <label>Review status<select id="evidence-filter"><option value="unreviewed">Unreviewed</option><option value="all">All</option><option value="reviewed">Reviewed</option></select></label>
  <label>Evidence scope<select id="evidence-scope"><option value="website">Affects website associations</option><option value="all">All imported candidates</option></select></label>
  <label class="evidence-search">Officer or radio ID<input id="evidence-search" type="search" placeholder="Name, officer ID, or radio ID"></label>
  <button type="submit">Search</button>
</form>
<p id="evidence-list-status" role="status" aria-live="polite"></p>
<div class="evidence-table-scroll"><table class="evidence-table">
  <thead><tr><th>Radio ID</th><th>Officer</th><th>Evidence group</th><th>Speaker clips</th><th>Review</th><th>Correction notes</th></tr></thead>
  <tbody id="evidence-groups"></tbody>
</table></div>
<nav class="evidence-pagination" aria-label="Evidence list pages"><button id="evidence-previous" type="button" disabled>Previous</button><span id="evidence-page"></span><button id="evidence-next" type="button" disabled>Next</button></nav>
{% endblock %}
