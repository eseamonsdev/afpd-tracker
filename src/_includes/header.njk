{% macro navLink(url, label) -%}
<a href="{{ url }}"{% if page.url == url %} aria-current="page"{% elif url != "/" and page.url and page.url.indexOf(url) == 0 %} aria-current="location"{% endif %}>{{ label }}</a>
{%- endmacro -%}
<header class="site-header">
  <div class="site-header-inner">
    <a class="site-title" href="/">
      American Fork Police Department<br>
      Accountability Project
    </a>

    <button class="nav-toggle" type="button" aria-expanded="true" aria-controls="main-navigation" hidden>
      <span aria-hidden="true">☰</span> Menu
    </button>
    <nav id="main-navigation" class="site-nav" aria-label="Main navigation">
      {{ navLink("/", "Home") }}
      {{ navLink("/police-encounters/", "Police Encounters") }}
      <details class="personnel-nav">
        <summary{% if page.url and (page.url.indexOf("/officers/") == 0 or page.url.indexOf("/civilian-employees/") == 0 or page.url.indexOf("/city-officials/") == 0) %} class="is-current-section"{% endif %}>Officers &amp; Personnel <span class="nav-chevron" aria-hidden="true"></span></summary>
        <div class="personnel-links">
          {{ navLink("/officers/", "Officers") }}
          {{ navLink("/civilian-employees/", "Civilian Employees") }}
          {{ navLink("/city-officials/", "City Officials") }}
        </div>
      </details>
      {{ navLink("/afpd-resources/", "AFPD Resources") }}
      {{ navLink("/city-oversight/", "City Oversight") }}
      {{ navLink("/police-radio/", "Police Radio") }}
    </nav>
  </div>
</header>
<script src="/js/header.js" defer></script>
