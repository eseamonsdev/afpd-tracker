<header class="site-header">
  <div class="site-header-inner">
    <a class="site-title" href="/">
      American Fork Police Department<br>
      Accountability Project
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a
        href="/"
        {% if page.url == "/" %}aria-current="page"{% endif %}
      >
        Home
      </a>

      <a
        href="/afpd-resources/"
        {% if page.url == "/afpd-resources/" %}
          aria-current="page"
        {% elif page.url and page.url.indexOf("/afpd-resources/") == 0 %}
          aria-current="location"
        {% endif %}
      >
        AFPD Resources
      </a>

      <a
        href="/police-encounters/"
        {% if page.url == "/police-encounters/" %}
          aria-current="page"
        {% elif page.url and page.url.indexOf("/police-encounters/") == 0 %}
          aria-current="location"
        {% endif %}
      >
        Police Encounters
      </a>

      <a
        href="/officers/"
        {% if page.url == "/officers/" %}
          aria-current="page"
        {% elif page.url and page.url.indexOf("/officers/") == 0 %}
          aria-current="location"
        {% endif %}
      >
        Officers
      </a>

      <a
        href="/civilian-employees/"
        {% if page.url == "/civilian-employees/" %}
          aria-current="page"
        {% elif page.url and page.url.indexOf("/civilian-employees/") == 0 %}
          aria-current="location"
        {% endif %}
      >
        Civilian Employees
      </a>

      <a
        href="/city-oversight/"
        {% if page.url == "/city-oversight/" %}
          aria-current="page"
        {% elif page.url and page.url.indexOf("/city-oversight/") == 0 %}
          aria-current="location"
        {% endif %}
      >
        City Oversight
      </a>
    </nav>
  </div>
</header>
