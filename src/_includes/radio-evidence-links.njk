{% macro evidenceLinks(days) -%}
<ul class="radio-evidence-links">
{%- for day in days -%}
  {%- set dayUrl = "" -%}
  {%- if day.talkgroup == 6001 or day.talkgroup == 5922 -%}
    {%- set dayUrl = "/police-radio/?date=" ~ day.date ~ "&talkgroup=" ~ day.talkgroup -%}
  {%- elif day.url -%}
    {%- set dayUrl = day.url -%}
  {%- endif -%}
  <li>{% if dayUrl %}<a href="{{ dayUrl | escape }}">{% endif %}<time datetime="{{ day.date | escape }}">{{ day.date | formatArticleDate | escape }}</time> · {% if day.talkgroup == 6001 %}Car-to-Car{% elif day.talkgroup == 5922 %}Law 2 Northeast{% else %}Talkgroup{% endif %} ({{ day.talkgroup }}){% if day.clips | length %} · {% if day.clips | length == 1 %}Clip{% else %}Clips{% endif %} {{ day.clips | join(", ") | escape }}{% else %} · No specific clip recorded{% endif %}{% if dayUrl %}</a>{% endif %}{% if not (day.clips | length) and day.records[0].evidence %}<p>{{ day.records[0].evidence | escape }}</p>{% endif %}</li>
{%- endfor -%}
</ul>
{%- endmacro %}
