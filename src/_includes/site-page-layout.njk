<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ pageTitle | escape }}</title>
  <meta name="description" content="{{ pageDescription | escape }}">
  <link rel="canonical" href="{{ canonicalUrl | escape }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AFPD Accountability Project">
  <meta property="og:title" content="{{ pageTitle | escape }}">
  <meta property="og:description" content="{{ pageDescription | escape }}">
  <meta property="og:url" content="{{ canonicalUrl | escape }}">

  <meta property="og:image" content="https://afpd-accountability.com/images/afpd-accountability-share.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="American Fork Police Department Accountability Project. Public records. Transparency. Accountability. afpd-accountability.com">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle | escape }}">
  <meta name="twitter:description" content="{{ pageDescription | escape }}">

  <meta name="twitter:image" content="https://afpd-accountability.com/images/afpd-accountability-share.png">
  <meta name="twitter:image:alt" content="American Fork Police Department Accountability Project. Public records. Transparency. Accountability. afpd-accountability.com">

  <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png">

  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/header.css">

  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/header.css">
{% block pageAssets %}{% endblock %}</head>
<body>
  {% include "header.njk" %}

  <main>{% block content %}{% endblock %}  </main>
</body>
</html>
