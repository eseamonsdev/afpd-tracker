{% extends "site-page-layout.njk" %}
{% from "document-tree.njk" import renderNodes -%}
{% from "latest-updates.njk" import renderLatestUpdates -%}
{% set siteUrl = "https://afpd-accountability.com" -%}
{% set pageTitle = "American Fork Police Department Accountability Project — Home" -%}
{% set pageDescription = "Explore public records involving the American Fork Police Department by encounter, officer, or topic." -%}
{% set canonicalUrl = siteUrl ~ "/" -%}

{% block pageAssets %}  <link rel="stylesheet" href="/css/document-tree.css">
  <link rel="stylesheet" href="/css/csv-table.css">
{% endblock %}

{% block content %}
    <div class="page-heading">
      <h1>Home</h1>
      <p>
        Explore public records and information about the American Fork Police Department.
        Use the links below to find profiles, documented encounters, and department resources.
      </p>
    </div>

    {{ renderLatestUpdates(entities.all["entity-police-encounter-page-benjamin-paul-schneider"].sections[0].latestUpdates, false, true) }}

    <section class="explore-project" aria-labelledby="explore-project-heading">
      <h2 class="explore-project-heading" id="explore-project-heading">Explore the Project</h2>
      <ul class="tree" aria-label="Explore the project">
        {{ renderNodes(root.tree) }}
      </ul>
    </section>
{% endblock %}
