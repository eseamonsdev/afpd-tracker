{% from "document-tree.njk" import renderNodes %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>American Fork Police Department Accountability Project — Document Repository</title>

  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/document-tree.css">
  <link rel="stylesheet" href="/css/csv-table.css">
</head>
<body>
  {% include "header.njk" %}

  <main>
    <div class="page-heading">
      <h1>Document Repository</h1>
      <p>
        Explore public records by encounter, officer, or topic.
        Select a folder to see its documents.
      </p>
    </div>

    <ul class="tree" aria-label="Document repository">
      {{ renderNodes(root.tree) }}
    </ul>
  </main>
</body>
</html>
