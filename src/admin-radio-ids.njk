<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Radio IDs | AFPD admin</title>
  <style>
    body { font: 1rem/1.5 system-ui, sans-serif; margin: 2rem auto; padding: 0 1rem; max-width: 48rem; color: #172338; }
    table { border-collapse: collapse; width: 100%; }
    th, td { padding: .55rem .75rem; text-align: left; border-bottom: 1px solid #cbd5e1; }
    th { background: #f1f5f9; }
  </style>
</head>
<body>
  <main>
    <h1>Radio IDs</h1>
    <p>Read-only list loaded directly from the AFPD D1 database.</p>
    <p id="status" role="status" aria-live="polite">Loading radio IDs…</p>
    <table id="radio-table" hidden>
      <caption>Radio IDs in D1</caption>
      <thead><tr><th scope="col">Radio ID</th></tr></thead>
      <tbody id="radio-rows"></tbody>
    </table>
  </main>
  <script type="module">
    const status = document.querySelector("#status");
    const table = document.querySelector("#radio-table");
    const body = document.querySelector("#radio-rows");
    try {
      const response = await fetch("/admin/api/radio-ids", { cache: "no-store" });
      if (!response.ok) throw new Error("Request failed (" + response.status + ")");
      const data = await response.json();
      if (!Array.isArray(data.radio_ids)) throw new Error("Unexpected response");
      for (const id of data.radio_ids) {
        const row = document.createElement("tr");
        const cell = document.createElement("td");
        cell.textContent = id;
        row.append(cell);
        body.append(row);
      }
      table.hidden = false;
      status.textContent = data.radio_ids.length + " radio IDs loaded from D1.";
    } catch (error) {
      status.textContent = "Could not load radio IDs: " + error.message;
    }
  </script>
</body>
</html>
