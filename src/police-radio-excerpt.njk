---
pagination:
  addAllPagesToCollections: true
  data: entities.byType.police-radio-excerpt-page
  size: 1
  alias: excerptPage
permalink: "{{ excerptPage.excerpt | excerptUrl }}"
---
{% extends "site-page-layout.njk" %}
{% from "radio-player.njk" import player %}
{% set excerpt = excerptPage.excerpt | radioExcerpt -%}
{% set title = excerpt.subtitle -%}
{% set pageTitle = title ~ " | AFPD Accountability Project" -%}
{% set pageDescription = excerpt.subtitle or title -%}
{% set canonicalUrl = "https://afpd-accountability.com" ~ excerpt.url -%}
{% block pageAssets %}
  <link rel="stylesheet" href="/css/police-radio.css">
  <link rel="stylesheet" href="/css/police-radio-excerpt.css">
  <script src="/js/radio-player-core.js" defer></script>
  <script src="/js/police-radio-excerpt.js" defer></script>
{% endblock %}
{% block content %}
    <nav class="excerpt-back-links" aria-label="Radio navigation">
      <a href="/police-radio-excerpts/">← All radio excerpts</a>
      <a href="/police-radio/">Full police radio archive</a>
      <a href="/police-radio-resources/">Police Radio Resources</a>
    </nav>
    <div class="page-heading excerpt-heading">
      <h1>{{ title | escape }}</h1>
      {% if excerpt.description %}<p>{{ excerpt.description | escape }}</p>{% endif %}
      <p>Audio from AFPD’s car-to-car radio talkgroup. Times shown in Mountain Time.</p>
      {% if excerpt.enableTranscription %}<p class="radio-transcript-note">AI-generated transcripts may contain errors. Verified transcripts have been reviewed against the audio; unclear passages may remain marked.</p>{% endif %}
    </div>
    <div class="radio-archive" id="radio-excerpt">
      {{ player("excerpt", excerpt.enableTranscription, false, "transcription-toggle", "transcription") }}
      <p class="radio-source-note">Recordings sourced from <a href="https://openmhz.com/" target="_blank" rel="noopener noreferrer">OpenMHz</a> and hosted independently. This site is not affiliated with or endorsed by OpenMHz.</p>
      <p>{{ excerpt.total }} selected clips · approximately {{ excerpt.duration | escape }} of audio. Playback skips the time between calls.</p>
      <div id="excerpt-clips">
      {% for section in excerpt.sections %}
        <section class="excerpt-section" aria-label="{{ section.title or ('Section ' ~ loop.index) | escape }}">
          {% if section.title %}<h2>{{ section.title | escape }}</h2>{% endif %}
          {% if section.description %}<p>{{ section.description | escape }}</p>{% endif %}
          {% for range in section.ranges %}
          <div class="excerpt-range">
            <p class="excerpt-range-label">{{ range.label | escape }} <span>({{ range.clipLabel | escape }})</span></p>
            <div class="radio-list-heading" aria-hidden="true"><span>Time · archive clip</span><span>Duration</span></div>
            <ol class="radio-clips">
            {% for call in range.calls %}
              <li><button type="button" class="radio-clip" data-excerpt-clip data-source="{{ call.source | escape }}" data-seconds="{{ call.seconds }}" data-label="{{ call.date | escape }} · {{ call.time | escape }} · Clip {{ call.number }}" data-radio-ids="{{ call.radioIds | escape }}" {% if excerpt.enableTranscription %}data-transcript="{{ call.transcript | escape }}" data-validated="{{ call.validated }}" {% if call.note %}data-note="{{ call.note | escape }}" {% endif %}{% endif %}aria-label="Play clip {{ call.number }}, {{ call.date | escape }}, {{ call.time | escape }}, {{ call.seconds }} seconds{% if call.radioIds %}, {{ call.radioIds | escape }}{% endif %}" disabled><span><time datetime="{{ call.iso | escape }}">{{ call.time | escape }}</time> <span class="excerpt-clip-number">· {{ call.number }}</span>{% if call.radioIds %}<span class="radio-ids">{{ call.radioIds | escape }}</span>{% endif %}</span><span>{{ call.seconds }} sec</span></button></li>
            {% endfor %}
            </ol>
          </div>
          {% endfor %}
        </section>
      {% endfor %}
      </div>
    </div>
    <noscript><p>Please enable JavaScript to play this excerpt, or open the original recordings:</p><ul>{% for section in excerpt.sections %}{% for range in section.ranges %}{% for call in range.calls %}<li><a href="{{ call.source | escape }}">{{ call.date | escape }} · {{ call.time | escape }} · Clip {{ call.number }}</a></li>{% endfor %}{% endfor %}{% endfor %}</ul></noscript>
{% endblock %}
