---
permalink: /law-2-radio/
---
{% extends "site-page-layout.njk" %}
{% from "radio-player.njk" import player %}
{% set pageTitle = "Law 2 Radio | AFPD Accountability Project" -%}
{% set pageDescription = "Listen to archived Law 2 Northeast recordings by date." -%}
{% set canonicalUrl = "https://afpd-accountability.com/law-2-radio/" -%}

{% block pageAssets %}
  <link rel="stylesheet" href="/css/police-radio.css">
  <script src="/js/radio-player-core.js" defer></script>
  <script src="/js/law-2-radio.js" defer></script>
{% endblock %}

{% block content %}
    <div class="page-heading">
      <h1>Law 2 Radio</h1>
      <p>Recordings from Law 2 Northeast (talkgroup 5922), a dispatch channel that includes American Fork police traffic.</p>
      <p>Times shown in Mountain Time. This archive may contain only part of a day or selected calls. Numeric radio IDs identify transmitting equipment; they do not independently identify an officer.</p>
      <p class="radio-source-note">AFPD marks radio IDs also observed on AFPD’s 6001 talkgroup; it does not independently identify the speaker.</p>
      <p class="radio-transcript-note">AI-generated transcripts may contain errors. Verified transcripts have been reviewed against the audio; unclear passages may remain marked.</p>
      <div id="law2-radio-review-progress" class="radio-review-progress" role="status" aria-label="Transcription and verification progress for the selected day" hidden>
        <span class="radio-progress-stat"><strong id="law2-radio-transcription-count"></strong> <span>clips transcribed</span></span>
        <span class="radio-progress-stat"><strong id="law2-radio-verification-count"></strong> <span>clips verified</span></span>
      </div>
    </div>
    <div class="radio-archive" id="law2-radio-archive">
      <div class="radio-date-selectors">
        <label for="law2-radio-month">Month
          <select id="law2-radio-month" disabled><option>Loading…</option></select>
        </label>
        <label for="law2-radio-day">Day
          <select id="law2-radio-day" disabled><option>Loading…</option></select>
        </label>
      </div>
      {{ player("law2-radio") }}
      <p class="radio-source-note">
        Recordings sourced from <a href="https://openmhz.com/" target="_blank" rel="noopener noreferrer">OpenMHz</a>
        and hosted independently. This player covers Law 2 Northeast only.
        This site is not affiliated with or endorsed by OpenMHz.
      </p>
      <p id="law2-radio-coverage" class="radio-source-note" hidden></p>
      <p id="law2-radio-status" role="status">Loading available dates…</p>
      <p id="law2-radio-transcript-availability" class="radio-transcript-note" hidden>Transcripts are not yet available for this day.</p>
      <section aria-label="Recorded clips" aria-busy="true" id="law2-radio-clips-section">
        <div class="radio-list-heading" aria-hidden="true"><span>Time · archive clip</span><span>Duration</span></div>
        <ol id="law2-radio-clips" class="radio-clips"></ol>
      </section>
    </div>
    <noscript><p>Please enable JavaScript to select dates and play recordings.</p></noscript>
{% endblock %}

