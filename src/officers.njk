---
permalink: /officers/
---
{% set siteUrl = "https://afpd-tracker.ericseamonsdeveloper.workers.dev" -%}
{% set pageTitle = "American Fork Police Officer Records | AFPD Accountability Project" -%}
{% set pageDescription = "Browse American Fork police officers with available employment records, incident documents, and other sources." -%}
{% set canonicalUrl = siteUrl ~ "/officers/" -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ pageTitle | escape }}</title>
  <meta name="description" content="{{ pageDescription | escape }}">
  <link rel="canonical" href="{{ canonicalUrl | escape }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AFPD Accountability Project">
  <meta property="og:title" content="{{ pageTitle | escape }}">
  <meta property="og:description" content="{{ pageDescription | escape }}">
  <meta property="og:url" content="{{ canonicalUrl | escape }}">

  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ pageTitle | escape }}">
  <meta name="twitter:description" content="{{ pageDescription | escape }}">

  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/officers.css">
  <script src="/js/officer-list-filters.js" defer></script>
</head>
<body>
  {% include "header.njk" %}

  <main>
    <div class="page-heading">
      <h1>Officers</h1>

      <div class="officer-filters" role="group" aria-label="Filter officers" hidden>
        <button
          class="officer-filter"
          type="button"
          data-officer-filter="key"
          aria-pressed="false"
        >
          Key Records
        </button>
        <button
          class="officer-filter"
          type="button"
          data-officer-filter="all"
          aria-pressed="false"
        >
          All
        </button>
        <button
          class="officer-filter"
          type="button"
          data-officer-filter="current"
          aria-pressed="false"
        >
          Current
        </button>
        <button
          class="officer-filter"
          type="button"
          data-officer-filter="former"
          aria-pressed="false"
        >
          Former
        </button>
      </div>

      <p id="officer-list-description" aria-live="polite">
        Browse every officer included in this directory, including those whose
        pages contain only basic employment information. Select a name to view
        the available records.
      </p>
    </div>

    <ul class="officer-list" aria-label="Officers" aria-describedby="officer-list-description">
      {% for officerPage in entities.byType["officer-page"] | sort(false, false, "name") %}
        <li
          data-key-records="{{ 'true' if officerPage['key-record'] == true else 'false' }}"
          data-employment-status="{{ officerPage['employment-status'] | escape }}"
        >
          <a href="{{ officerPage.url | escape }}">
            <span>{{ officerPage.name | escape }}</span>
            <span class="officer-list-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </main>
</body>
</html>
