permalink: /officers/
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Officers — American Fork Police Department Accountability Project</title>

  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/officers.css">
</head>
<body>
  {% include "header.njk" %}

  <main>
    <div class="page-heading">
      <h1>Officers</h1>
      <p>
        Browse officers alphabetically by name.
        Select a name to explore the available records.
      </p>
    </div>

    <ul class="officer-list" aria-label="Officers">
      {% for officerPage in entities.byType["officer-page"] | sort(false, false, "name") %}
        <li>
          <a href="{{ officerPage.url | escape }}">
            <span>{{ officerPage.name | escape }}</span>
            <span class="officer-list-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </main>
</body>
</html>
