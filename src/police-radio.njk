---
permalink: /police-radio/
---
{% extends "site-page-layout.njk" %}
{% set pageTitle = "Police Radio | AFPD Accountability Project" -%}
{% set pageDescription = "Browse recorded police radio calls by date and listen to individual clips." -%}
{% set canonicalUrl = "https://afpd-accountability.com/police-radio/" -%}

{% block pageAssets %}
  <link rel="stylesheet" href="/css/police-radio.css">
  <script src="/js/police-radio.js" defer></script>
{% endblock %}

{% block content %}
    <div class="page-heading">
      <h1>Police Radio</h1>
      <p>Audio from a car-to-car radio talkgroup used by the American Fork Police Department (AFPD).</p>
      <p><a href="/police-radio-excerpts/">Browse radio excerpts</a> for selected discussions, or explore the full archive below.</p>
      <p><a href="/police-radio-resources/">Police Radio Resources</a> explains agency call signs and provides radio-ID references.</p>
      <p>Times shown in Mountain Time. Officer names show confirmed associations for the selected date or strong associations across other dates. Single-day associations stay on their supported date. Select ⓘ for the evidence and limits; names do not independently verify the speaker in every clip.</p>
      <p class="radio-transcript-note">AI-generated transcripts may contain errors. Verified transcripts have been reviewed against the audio; unclear passages may remain marked.</p>
    </div>
    <div class="radio-archive" id="radio-archive">
      <div class="radio-date-selectors">
        <label for="radio-month">Month
          <select id="radio-month" disabled><option>Loading…</option></select>
        </label>
        <label for="radio-day">Day
          <select id="radio-day" disabled><option>Loading…</option></select>
        </label>
      </div>
      <section class="radio-player" aria-label="Audio player">
        <div class="radio-player-heading">
          <div>
            <p id="radio-current">Choose a clip to listen</p>
            <p id="radio-current-radio-ids" class="radio-ids" hidden></p>
          </div>
          <div class="radio-player-actions">
            <button id="radio-show-current" type="button" aria-controls="radio-clips" disabled>Show Current Clip</button>
            <button id="radio-autoplay" type="button" aria-pressed="false">Autoplay: Off</button>
            <button id="radio-transcript-toggle" type="button" aria-pressed="false" aria-controls="radio-transcript" hidden disabled>Transcript: Off</button>
            <a id="radio-transcript-download" download hidden>Download transcript (.txt)</a>
          </div>
        </div>
        <div class="radio-playback">
          <button id="radio-play" type="button" aria-label="Play selected clip" disabled>Play</button>
          <div class="radio-progress">
            <label class="radio-sr-only" for="radio-seek">Position in clip</label>
            <input id="radio-seek" type="range" min="0" max="0" step="0.1" value="0" disabled>
            <div class="radio-times"><span id="radio-elapsed">0:00</span><span id="radio-duration">0:00</span></div>
          </div>
        </div>
        <p id="radio-player-message" role="status"></p>
        <div id="radio-transcript" class="radio-transcript" role="region" aria-label="Current clip transcript" aria-live="polite" aria-atomic="true" hidden>
          <span id="radio-transcript-status" class="radio-transcript-status" hidden></span>
          <p class="radio-transcript-label"><strong>Transcript:</strong></p>
          <p id="radio-transcript-text"></p>
          <details id="radio-call-note" class="radio-call-note" hidden>
            <summary><span class="radio-notes-view">View Notes</span><span class="radio-notes-hide">Hide Notes</span></summary>
            <p id="radio-call-note-text"></p>
          </details>
        </div>
        <audio id="radio-audio" preload="metadata"></audio>
      </section>
      <p class="radio-source-note">
        Recordings sourced from <a href="https://openmhz.com/" target="_blank" rel="noopener noreferrer">OpenMHz</a>
        and hosted independently. This archive covers only American Fork PD’s Car-to-Car talkgroup.
        This site is not affiliated with or endorsed by OpenMHz.
      </p>
      <p id="radio-status" role="status">Loading available dates…</p>
      <p id="radio-transcript-availability" class="radio-transcript-note" hidden>Transcripts are not yet available for this day.</p>
      <section aria-label="Recorded clips" aria-busy="true" id="radio-clips-section">
        <div class="radio-list-heading" aria-hidden="true"><span>Time · archive clip</span><span>Duration</span></div>
        <ol id="radio-clips" class="radio-clips"></ol>
      </section>
    </div>
    <noscript><p>Please enable JavaScript to select dates and play recordings.</p></noscript>
{% endblock %}

