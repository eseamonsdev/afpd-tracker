---
permalink: /police-radio/
---
{% extends "site-page-layout.njk" %}
{% from "radio-navigation.njk" import radioNavigation %}
{% from "radio-player.njk" import player %}
{% from "radio-date-picker.njk" import datePicker %}
{% set pageTitle = "Police Radio | AFPD Accountability Project" -%}
{% set pageDescription = "Browse recorded police radio calls by date and listen to individual clips." -%}
{% set canonicalUrl = "https://afpd-accountability.com/police-radio/" -%}

{% block pageAssets %}
  <link rel="stylesheet" href="/css/police-radio.css">
  <link rel="stylesheet" href="/css/radio-date-picker.css">
  <script src="/js/radio-date-picker.js" defer></script>
  <script src="/js/radio-player-core.js" defer></script>
  <script src="/js/police-radio.js" defer></script>
{% endblock %}

{% block content %}
    {{ radioNavigation(page.url) }}
    <div class="page-heading">
      <h1>Police Radio</h1>
      <label class="radio-talkgroup-selector" for="radio-talkgroup">Talkgroup
        <select id="radio-talkgroup">
          <option value="6001">AFPD Car to Car (6001)</option>
          <option value="5922">Law 2 Northeast (5922)</option>
        </select>
      </label>
      <p id="radio-talkgroup-description">Audio from a car-to-car radio talkgroup used by the American Fork Police Department (AFPD).</p>
      <p id="radio-talkgroup-note" class="radio-source-note" hidden>Recordings may contain only part of a day or selected calls. AFPD marks radio IDs also observed on the Car-to-Car talkgroup; it does not independently identify the speaker.</p>
      <p><a href="/police-radio-excerpts/">Browse radio excerpts</a> for selected discussions, or explore the full archive below.</p>
      <p><a href="/police-radio-resources/">Police Radio Resources</a> explains agency call signs and provides radio-ID references.</p>
      <p>Times shown in Mountain Time. Officer names show confirmed associations for the selected date or strong associations across other dates. Single-day associations stay on their supported date. Select <span class="radio-info-example" role="img" aria-label="the information icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7h.01"></path></svg></span> for the evidence and limits; names do not independently verify the speaker in every clip.</p>
      <p class="radio-transcript-note">AI-generated transcripts may contain errors. Verified transcripts have been reviewed against the audio; unclear passages may remain marked.</p>
      <div id="radio-review-progress" class="radio-review-progress" role="status" aria-label="Transcription and verification progress for the selected day" hidden>
        <span class="radio-progress-stat"><strong id="radio-transcription-count"></strong> <span>clips transcribed</span></span>
        <span class="radio-progress-stat"><strong id="radio-verification-count"></strong> <span>clips verified</span></span>
        <span id="radio-progress-date" class="radio-progress-stat"></span>
      </div>
    </div>
    <div class="radio-archive" id="radio-archive">
      {{ datePicker("radio") }}
      {{ player("radio", initiallyHidden=true) }}
      <p class="radio-source-note">
        Recordings sourced from <a href="https://openmhz.com/" target="_blank" rel="noopener noreferrer">OpenMHz</a>
        and hosted independently.
        This site is not affiliated with or endorsed by OpenMHz.
      </p>
      <p id="radio-coverage" class="radio-source-note" hidden></p>
      <p id="radio-status" role="status">Loading available dates…</p>
      <p id="radio-transcript-availability" class="radio-transcript-note" hidden>Transcripts are not yet available for this day.</p>
      <section aria-label="Recorded clips" aria-busy="true" id="radio-clips-section">
        <div class="radio-list-heading" aria-hidden="true"><span>Time · archive clip</span><span>Duration</span></div>
        <ol id="radio-clips" class="radio-clips"></ol>
      </section>
    </div>
    <noscript><p>Please enable JavaScript to select dates and play recordings.</p></noscript>
{% endblock %}

