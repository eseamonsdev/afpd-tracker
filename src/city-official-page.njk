---
pagination:
  data: entities.byType.city-official-page
  size: 1
  alias: cityOfficialPage
permalink: "{{ cityOfficialPage.url }}"
---
{% extends "site-page-layout.njk" %}
{% from "document-tree.njk" import renderNodes -%}
{% set siteUrl = "https://afpd-accountability.com" -%}
{% set pageTitle = cityOfficialPage.name ~ " — City Official Records | AFPD Accountability Project" -%}
{% set defaultDescription = "Explore available employment, compensation, and other records related to " ~ cityOfficialPage.name ~ " and American Fork City." -%}
{% set pageDescription = cityOfficialPage.seo_description or defaultDescription -%}
{% set canonicalUrl = siteUrl ~ cityOfficialPage.url -%}
{% set sections = cityOfficialPage.sections | publishedSections -%}

{% block pageAssets %}  <link rel="stylesheet" href="/css/document-tree.css">
  <link rel="stylesheet" href="/css/officer-page.css">
  <link rel="stylesheet" href="/css/csv-table.css">

  {% if sections | length %}
    <script src="/js/officer-tabs.js" defer></script>
  {% endif %}
{% endblock %}

{% block content %}
    <a class="officer-back-link" href="/city-officials/">
      ← All city officials
    </a>

    <div class="page-heading">
      <p class="officer-category-label">CITY OFFICIAL RECORDS</p>
      <h1>{{ cityOfficialPage.name | escape }}</h1>
    </div>

    {% if sections | length %}
      <div class="officer-sections" data-officer-sections>
        <div
          class="officer-section-tabs"
          data-section-tabs
          hidden
        >
          {% for section in sections %}
            <button
              class="officer-section-tab"
              id="officer-tab-{{ loop.index }}"
              type="button"
              data-section-tab
              aria-controls="officer-section-{{ loop.index }}"
            >
              {{ section.title | escape }}
            </button>
          {% endfor %}
        </div>

        {% for section in sections %}
          <section
            class="officer-section-panel"
            id="officer-section-{{ loop.index }}"
            aria-labelledby="officer-section-heading-{{ loop.index }}"
            data-section-panel
          >
            <h2 id="officer-section-heading-{{ loop.index }}">
              {{ section.title | escape }}
            </h2>

            {% if section.descriptions and section.descriptions | length %}
              <div class="officer-section-descriptions">
                {% for description in section.descriptions %}
                  <p>{{ description | escape }}</p>
                {% endfor %}
              </div>
            {% endif %}

            {% if section.contents and section.contents | length %}
              <ul
                class="tree"
                aria-label="{{ section.title | escape }}"
              >
                {{ renderNodes(section.contents) }}
              </ul>
            {% endif %}
          </section>
        {% endfor %}
      </div>
    {% endif %}
{% endblock %}
