---
permalink: /police-radio-excerpts/
---
{% extends "site-page-layout.njk" %}
{% set pageTitle = "Police Radio Excerpts | AFPD Accountability Project" -%}
{% set pageDescription = "Browse selected AFPD car-to-car radio discussions with descriptive titles and original timestamps." -%}
{% set canonicalUrl = "https://afpd-accountability.com/police-radio-excerpts/" -%}
{% block pageAssets %}
  <link rel="stylesheet" href="/css/police-radio-excerpt.css">
{% endblock %}
{% block content %}
    <a class="excerpt-back-link" href="/police-radio/">← Full police radio archive</a>
    <div class="page-heading excerpt-heading">
      <h1>Police Radio Excerpts</h1>
      <p>Selected discussions from AFPD’s car-to-car radio talkgroup. Choose an excerpt to listen with original Mountain Time timestamps.</p>
      <p>Audio lengths below are approximate totals, excluding the gaps between calls.</p>
      <p><a href="/police-radio-resources/">Police Radio Resources</a> explains agency call signs and provides radio-ID references.</p>
    </div>
    <ul class="excerpt-index" aria-label="Police radio excerpts">
    {% for excerptPage in entities.byType["police-radio-excerpt-page"] | sort(false, false, "excerpt.number") %}
      {% set excerpt = excerptPage.excerpt | radioExcerpt %}
      <li>
        <a class="excerpt-index-link" href="{{ excerpt.url | escape }}">
          <span class="excerpt-index-title">{{ excerpt.subtitle | escape }}</span>
          <span class="excerpt-index-duration">{% if excerpt.durationSeconds > 60 %}{{ excerpt.duration | escape }}{% else %}{{ excerpt.durationSeconds }} sec{% endif %} · {{ excerpt.total }} clips</span>
        </a>
      </li>
    {% else %}
      <li class="excerpt-index-empty">No excerpts are available yet.</li>
    {% endfor %}
    </ul>
{% endblock %}
