      "language": {
        "title": "Radio language",
        "description": "Short meanings for terms you may hear. Codes and abbreviations can vary by agency; use the surrounding conversation to interpret them.",
        "sourceIds": [
          "utah-ten-codes",
          "radio-glossary"
        ],
        "entries": [
          {
            "term": "10-4",
            "meaning": "OK; message received or acknowledged.",
            "example": "Used to acknowledge a transmission."
          },
          {
            "term": "Code 4",
            "meaning": "Situation under control; no further assistance needed.",
            "example": "It describes the need for assistance, not necessarily the end of the call."
          },
          {
            "term": "10-9",
            "meaning": "Repeat the last message.",
            "example": "“10-9, my radio cut out” is a request to hear the message again."
          },
          {
            "term": "10-14",
            "meaning": "Information.",
            "example": "In Utah radio usage, “10-21 for 10-14” means call by phone for information."
          },
          {
            "term": "10-20 / What’s your 20?",
            "meaning": "Location.",
            "example": "“What’s your 20?” means “Where are you?” “My 20 is…” means “I’m at…” followed by a location."
          },
          {
            "term": "10-21",
            "meaning": "Call by phone.",
            "example": "A request to continue the conversation by telephone."
          },
          {
            "term": "10-8",
            "meaning": "In service; available for calls.",
            "example": "November 1, 2026, Law 2 (5922), clip 1132, 11:48:36 PM Mountain: “5J53, I'll be 10-8.” Transcript not yet marked verified."
          },
          {
            "term": "10-17",
            "meaning": "En route.",
            "example": "November 1, 2026, Law 2 (5922), clip 891, 7:50:32 PM Mountain: “[Please?] show me 10-17 to address…” Transcript excerpt; not yet marked verified."
          },
          {
            "term": "Disregard / 10-22",
            "meaning": "Cancel or ignore the previous message or request.",
            "example": "November 2, 2026, AFPD car-to-car (6001), clip 45, 1:26:32 PM Mountain: “They're able to push it out of the way, you can 10-22.” Transcript marked verified."
          },
          {
            "term": "10-23",
            "meaning": "Arrived at the scene.",
            "example": "November 1, 2026, Law 2 (5922), clip 886, 7:47:41 PM Mountain: “[7J29?], 10-23.” Transcript not yet marked verified; the unit identifier is uncertain."
          },
          {
            "term": "10-28",
            "meaning": "Vehicle ownership or registration information.",
            "example": "Heard in the calls by the site owner; an exact dated clip has not yet been recorded here."
          },
          {
            "term": "Copy",
            "meaning": "Message received or understood.",
            "example": "An acknowledgment does not necessarily identify the person being addressed."
          },
          {
            "term": "Affirm / Affirmative",
            "meaning": "Yes.",
            "example": "A short reply may need the preceding clip to make sense."
          },
          {
            "term": "Negative",
            "meaning": "No.",
            "example": "A short reply may need the preceding clip to make sense."
          },
          {
            "term": "RP",
            "meaning": "Usually the reporting party: the person who reported the incident.",
            "example": "It describes a role in the call, not necessarily a victim or suspect."
          },
          {
            "term": "PD",
            "meaning": "Police department.",
            "example": "“At the PD” commonly means at the police station."
          },
          {
            "term": "Car-to-car",
            "meaning": "Officer-to-officer radio conversation.",
            "example": "The archive on this site covers AFPD’s car-to-car talkgroup, 6001."
          }
        ]
      },
      "officers": {
        "title": "Names, nicknames, and radio IDs",
        "description": "Full officer names and unresolved names from the combined evidence. During this review, all imported observations count by distinct date, including tentative readings and conflicts. Three dates give a possible association; four or more give a strong association. Original names heard, uncertainty, repeats, and alternative candidates remain in the evidence for Eric to review.",
        "sourceIds": [],
        "unresolved": "Unresolved names and multiple candidates are deliberately retained. A full roster name is a candidate match, not a decision that the name was heard correctly. Evidence dates count once per officer and radio ID, regardless of clip count."
      },
      "idExplanation": "The numeric radio ID beside a clip identifies a transmitting radio. A spoken call sign identifies a unit or agency; a talkgroup identifies the conversation channel.",
