      "id": "entity-page-police-radio-resources",
      "type": "police-radio-resources-page",
      "title": "Police Radio Resources",
      "description": "A quick listening guide to agency call signs, radio language, officer names, and radio IDs in AFPD recordings.",
      "attributionNote": "An officer may have used an ID in these exchanges without being the speaker in every recording under that ID. Attributing a particular statement to an officer still requires further confirmation.",
      "callSigns": {
        "title": "Agency call signs",
        "description": "The agency part of a spoken unit identifier tells you which department is calling. J is spoken as “Juliet.” For example, the 5J in 5J171 identifies American Fork; it does not identify the officer by itself.",
        "sourceIds": [
          "utah-county",
          "utah-state"
        ],
        "entries": [
