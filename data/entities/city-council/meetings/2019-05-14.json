    {
      "id": "entity-city-official-remark-2019-05-14-bradley-j-frost-new-officers",
      "type": "formatted-text",
      "speaker": "Bradley J. Frost",
      "speaker-role": "Mayor",
      "remark-context": "Swearing in of four police officers",
      "source-pages": [
        3
      ],
      "segments": [
        {
          "text": "Mayor Frost said he was pleased about the swearing in of four new American Fork police officers. He paid tribute to Chief Falslev and stated that three of the four recruits were attracted to American Fork because they wanted to work with him."
        },
        {
          "text": " "
        },
        {
