    {
      "id": "entity-city-official-remark-2019-05-14-david-h-bunker-police-week",
      "type": "formatted-text",
      "speaker": "David H. Bunker",
      "speaker-role": "City Administrator",
      "remark-context": "Police Week",
      "source-pages": [
        3
      ],
      "segments": [
        {
          "text": "Mr. Bunker reported that it was Police Week, announced an open house at the Police Department, and said American Fork had an outstanding department."
