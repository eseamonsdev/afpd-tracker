        }
      ]
    },
    {
      "id": "entity-city-official-remark-2019-05-14-staci-carroll-patrol-car-crash",
      "type": "formatted-text",
      "speaker": "Staci Carroll",
      "speaker-role": "Council Member",
      "remark-context": "Police patrol-car crash",
      "source-pages": [
        4
      ],
      "segments": [
        {
          "text": "Council Member Carroll shared that a police officer had recently been involved in a crash when another vehicle turned a corner and struck the officer's patrol car head-on while it was at a stop sign. She noted that no one was seriously injured."
        },
        {
          "text": " "
        },
        {
