    {
      "id": "entity-city-official-remark-2019-05-14-clark-p-taylor-enforcement",
      "type": "formatted-text",
      "speaker": "Clark P. Taylor",
      "speaker-role": "Council Member",
      "remark-context": "Short-term-rental enforcement policy",
      "source-pages": [
        6
      ],
      "segments": [
        {
          "text": "Council Member Taylor stated that there was not enough money to hire enough enforcement officers. He said the proposed short-term-rental ordinance needed better enforcement provisions and restrictions before it was adopted."
        },
        {
          "text": " "
        },
        {
          "format": "link",
          "text": "View minutes, page 6",
          "url": "/records/american-fork-city/city-council-session-minutes/american-fork-city-council-regular-session-minutes-2019-05-14.pdf#page=6"
        }
      ]
    },
    {
      "id": "entity-city-official-remark-2019-05-14-kevin-j-barnes-enforcement",
      "type": "formatted-text",
      "speaker": "Kevin J. Barnes",
      "speaker-role": "Council Member",
      "remark-context": "Short-term-rental enforcement policy",
      "source-pages": [
        6
      ],
      "segments": [
        {
          "text": "Council Member Barnes said the Council needed to investigate how the proposed short-term-rental ordinance would affect residents and the police force. He noted that residents had called him about problems and said police needed to be contacted when problems occurred."
        },
        {
          "text": " "
        },
