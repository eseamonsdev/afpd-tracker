      "id": "entity-city-official-remark-2020-06-09-david-h-bunker-public-safety-retirement",
      "type": "formatted-text",
      "speaker": "David H. Bunker",
      "speaker-role": "City Administrator",
      "remark-context": "Public-safety retirement contributions",
      "source-pages": [
