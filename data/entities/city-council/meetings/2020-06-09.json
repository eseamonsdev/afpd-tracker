      "id": "entity-city-official-remark-2020-06-09-kevin-j-barnes-public-safety-retirement",
      "type": "formatted-text",
      "speaker": "Kevin J. Barnes",
      "speaker-role": "Council Member",
      "remark-context": "Public-safety retirement contributions",
      "source-pages": [
        8
      ],
      "segments": [
        {
          "text": "Council Member Barnes commented on the estimated annual budget impact of $7,000 and noted that the effect could continue to change as more employees transitioned from Tier I to Tier II retirement coverage."
