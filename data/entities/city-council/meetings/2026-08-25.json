    {
      "id": "entity-public-comment-2026-08-25-gregory-titus",
      "type": "formatted-text",
      "speaker": "Gregory Titus",
      "comment-context": "Public comment period",
      "source-pages": [
        3
      ],
      "segments": [
        {
          "format": "bold",
          "text": "Gregory Titus"
        },
        {
          "text": " stated that his and his wife’s constitutional rights had been violated in American Fork. He expressed a willingness to work with City officials and invited them to contact him regarding his concerns."
        },
