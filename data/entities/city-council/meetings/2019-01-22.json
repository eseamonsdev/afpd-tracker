    {
      "id": "entity-city-council-discussion-2019-01-22-dispatch-technology",
      "type": "folder",
      "label": "Dispatch technology intended to reduce response times",
      "anchor": "discussion-2019-01-22-dispatch-technology",
      "contents": [
        {
          "type": "formatted-text",
          "preserve-paragraphs": true,
          "segments": [
            {
              "format": "bold",
              "text": "Context written for this site: "
            },
            {
              "text": "During his council report, Council Member Robert Shelton described dispatch technology that he said could reduce emergency-response times and asked the council to consider implementing it."
            },
            {
              "text": "\n\n"
            },
            {
              "format": "bold",
              "text": "Relevant passage from the official meeting minutes: "
            },
            {
              "text": "\n\nCouncil Member Shelton reported that he was able to preview new technology. This technology was revolutionizing dispatch services by reducing response times. He asked that the Council consider implementing it in the City.\n\n"
            },
            {
              "format": "link",
              "text": "View minutes, page 2",
              "url": "/records/american-fork-city/city-council-session-minutes/american-fork-city-council-regular-session-minutes-2019-01-22.pdf#page=2"
            }
          ]
        }
      ]
    },
    {
