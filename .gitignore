# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
node_modules
__pycache__/
*.py[cod]

# New radio audio is verified in R2; existing tracked recordings remain backups.
/public/records/openmhz/**/*.m4a

# Rebuildable local officer-name database; commit schema and import code instead.
/db/local/
/db/*.sqlite*

# Ignore any locally generated files from the retired database viewer.
/public/db/
